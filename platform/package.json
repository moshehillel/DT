{
  "name": "pos-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant retail/repair/rental platform (Diamant Telecom is tenant #1).",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "build": "pnpm -r run build",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @pos/db run migrate",
    "db:seed": "pnpm --filter @pos/db run seed",
    "dev:api": "pnpm --filter @pos/api run dev",
    "dev:worker": "pnpm --filter @pos/worker run dev",
    "dev:web": "pnpm --filter @pos/web run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
