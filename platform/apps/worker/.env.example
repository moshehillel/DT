# Copy to .env for local development. Never commit real values.
NODE_ENV=development
# Same non-owner login as the API (member of app_user).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pos
LOG_LEVEL=info

# "fake" logs-and-pretends for local dev; "real" uses per-tenant secrets and is required in production.
PROVIDERS=fake
POLL_INTERVAL_MS=2000
RECONCILE_INTERVAL_MS=900000
REMINDER_INTERVAL_MS=3600000

# Per-tenant provider secrets (PROVIDERS=real), read as TENANT_<SLUG>__<NAME>:
# TENANT_DIAMANT_TELECOM__TELEBROAD_USERNAME=
# TENANT_DIAMANT_TELECOM__TELEBROAD_PASSWORD=
# TENANT_DIAMANT_TELECOM__TELEBROAD_SMS_LINE=
# TENANT_DIAMANT_TELECOM__TWILIO_ACCOUNT_SID=
# TENANT_DIAMANT_TELECOM__TWILIO_AUTH_TOKEN=
# TENANT_DIAMANT_TELECOM__TWILIO_FROM_NUMBER=
# TENANT_DIAMANT_TELECOM__SOLA_API_KEY=
# TENANT_DIAMANT_TELECOM__RCUK_API_KEY=
