# dev = paste a dev token (HS256 signed with the API's DEV_AUTH_SECRET); firebase = email/password sign-in
VITE_AUTH_MODE=dev
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_DEV_TOKEN=
# Optional: defaults to /api/v2 (proxied to http://localhost:8080 by `vite dev`)
VITE_API_BASE=
