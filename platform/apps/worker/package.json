{
  "name": "@pos/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup src/main.ts --format esm --target node22 --clean --sourcemap --noExternal @pos/domain --noExternal @pos/contracts --noExternal @pos/db --noExternal @pos/adapters --noExternal @pos/api",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@pos/adapters": "workspace:*",
    "@pos/api": "workspace:*",
    "@pos/db": "workspace:*",
    "@pos/domain": "workspace:*",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  }
}
