# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=8080
# The API connects with a login role that is a member of app_user (NOT the table owner).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pos
LOG_LEVEL=info

# Auth: "firebase" verifies Firebase / Identity Platform ID tokens.
# "dev" accepts HS256 tokens signed with DEV_AUTH_SECRET and is refused when NODE_ENV=production.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
DEV_AUTH_SECRET=change-me-dev-only-secret-at-least-32-chars

# Signs short-lived cashier "operator" tokens after a PIN switch.
OPERATOR_TOKEN_SECRET=change-me-operator-secret-at-least-32-chars

# Field encryption for device passcodes / account PINs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Format: keyId:base64key[,keyId:base64key]  (old keys stay for decryption during rotation)
FIELD_ENCRYPTION_KEYS=k1:REPLACE_WITH_32_BYTE_BASE64_KEY
FIELD_ENCRYPTION_CURRENT_KEY=k1

# Payment gateway: "fake" for local dev, "cardknox" in production.
PAYMENT_GATEWAY=fake

# Per-tenant provider secrets are read as TENANT_<SLUG>__<NAME>, e.g.
# TENANT_DIAMANT_TELECOM__SOLA_API_KEY=
# TENANT_DIAMANT_TELECOM__TWILIO_AUTH_TOKEN=
# TENANT_DIAMANT_TELECOM__SHOPIFY_WEBHOOK_SECRET=
# TENANT_DIAMANT_TELECOM__TELEBROAD_WEBHOOK_TOKEN=

# Allowed browser origins for CORS (comma separated)
CORS_ORIGINS=http://localhost:5173
# Public base URL used to verify Twilio signatures behind a proxy
PUBLIC_BASE_URL=http://localhost:8080
