{
  "name": "@pos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup src/server.ts --format esm --target node22 --clean --sourcemap --noExternal @pos/domain --noExternal @pos/contracts --noExternal @pos/db --noExternal @pos/adapters",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@pos/adapters": "workspace:*",
    "@pos/contracts": "workspace:*",
    "@pos/db": "workspace:*",
    "@pos/domain": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  }
}
